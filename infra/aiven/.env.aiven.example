# Managed services on Aiven. Copy to <repo root>/.env.aiven (gitignored) and fill in.
# Values come from each service's Overview > Connection information in the Aiven console.
# Real credentials never go in this file or in git.

# --- PostgreSQL -----------------------------------------------------------------
# Service URI, with ?sslmode=require. Mind the connection limit (20 on small plans):
# web (10) + ingestion-go + scheduled-worker pools must fit under it.
DATABASE_URL=postgres://avnadmin:<PG_PASSWORD>@<pg-host>.aivencloud.com:<PG_PORT>/defaultdb?sslmode=require

# --- ClickHouse (HTTPS) ----------------------------------------------------------
CLICKHOUSE_URL=https://<clickhouse-host>.aivencloud.com:<CH_PORT>
CLICKHOUSE_USER=avnadmin
CLICKHOUSE_PASSWORD=<CH_PASSWORD>
# Create this database from the console (Databases and tables) so Aiven makes it a
# Replicated database, then use the same name here.
CLICKHOUSE_DB=growth_analytics
# Read-only dashboard user (required when NODE_ENV=production). Create it in the
# console under Users, then grant SELECT on the database. See infra/aiven/README.md.
# CLICKHOUSE_DASHBOARD_USER=dashboard_ro
# CLICKHOUSE_DASHBOARD_PASSWORD=<DASHBOARD_PASSWORD>
# Only if the service uses a private CA. Aiven ClickHouse normally needs none.
# CLICKHOUSE_CA_CERT_PATH=infra/aiven/certs/clickhouse-ca.pem

# --- Kafka (SASL over TLS) --------------------------------------------------------
KAFKA_BROKERS=<kafka-host>.aivencloud.com:<KAFKA_SASL_PORT>
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=<KAFKA_PASSWORD>
# Download "CA certificate" from the Kafka Overview page.
KAFKA_CA_CERT_PATH=infra/aiven/certs/ca.pem
KAFKA_TOPIC=growth_events
KAFKA_DLQ_TOPIC=growth_events_dlq
KAFKA_CONSUMER_GROUP=event_worker_group
# Used only by create-kafka-topics.mjs. Match WORKER_PARTITION_CONCURRENCY x replicas.
KAFKA_PARTITIONS=2
KAFKA_REPLICATION=2

# --- Valkey (Redis-compatible, TLS) -----------------------------------------------
# Service URI from the Valkey Overview page. The per-role REDIS_*_URL vars default to it.
# Set valkey_maxmemory_policy=noeviction in the service's advanced settings.
REDIS_URL=rediss://default:<REDIS_PASSWORD>@<valkey-host>.aivencloud.com:<REDIS_PORT>
