# ==============================================================================
# Growth Intelligence Platform - Environment Variables Template
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000
INGESTION_URL=http://localhost:3001
TRACKER_CDN_URL=http://localhost:3000/tracker.js

# Authentication & Session Security
NEXTAUTH_SECRET=super-secret-random-key-change-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3000
# Optional. Scope the session cookie to the parent domain (for example .example.com) so the
# docs site can recognize a signed-in visitor. Leave unset when both apps share one host.
# SESSION_COOKIE_DOMAIN=

# PostgreSQL (Control Plane & Tenancy Data)
POSTGRES_USER=growth_admin
POSTGRES_PASSWORD=growth_secure_pass
POSTGRES_DB=growth_intelligence
POSTGRES_PORT=5432
DATABASE_URL=postgres://growth_admin:growth_secure_pass@localhost:5432/growth_intelligence

# ClickHouse (Analytical & Raw Event Warehouse)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_dev_secret
CLICKHOUSE_DB=growth_analytics
CLICKHOUSE_URL=http://localhost:8123
# Read-only user for dashboard queries; REQUIRED in production (create it with infra/ops/clickhouse-dashboard-ro.sql)
# CLICKHOUSE_DASHBOARD_USER=dashboard_ro
# CLICKHOUSE_DASHBOARD_PASSWORD=

# Redis (split by failure domain in production; all default to REDIS_URL in dev/small deployments)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret
REDIS_URL=redis://:redis_dev_secret@localhost:6379
REDIS_RATELIMIT_URL=redis://:redis_dev_secret@localhost:6379
REDIS_CACHE_URL=redis://:redis_dev_secret@localhost:6379
REDIS_STATE_URL=redis://:redis_dev_secret@localhost:6379
REDIS_COORD_URL=redis://:redis_dev_secret@localhost:6379

# Kafka (durable event bus: Go ingest → event-worker)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=growth_events
KAFKA_DLQ_TOPIC=growth_events_dlq
KAFKA_CONSUMER_GROUP=event_worker_group
# Producer codec at the edge: zstd (brokers >= 2.1), snappy, lz4, gzip or none.
# The event worker decodes zstd and gzip only; snappy/lz4 would need a kafkajs codec added there.
KAFKA_COMPRESSION=zstd
# Edge admission: one Redis script for IP + site limit + dedupe claims + quota
EDGE_GATE_SCRIPT=true

# Ingestion Service Configuration (Go only)
INGESTION_PORT=3001
INGESTION_RATE_LIMIT_MAX=1000
INGESTION_RATE_LIMIT_WINDOW_MS=60000
# Requests per window for one site (all its visitors together). INGESTION_RATE_LIMIT_MAX is per client IP.
SITE_RATE_LIMIT_MAX=10000
# Fail closed when the admission store is unreachable. Fail-open silently bypasses
# rate limit, dedupe and quota; keep this true outside local experiments.
ADMISSION_FAIL_CLOSED=true
# Only used when ADMISSION_FAIL_CLOSED=false. Metering can reconcile the count later.
QUOTA_FAIL_OPEN=false
# Edge dedupe (event-ID claims). Safe to leave on: ClickHouse also dedupes on event_id.
EDGE_DEDUPE=true
MAX_EVENT_PAYLOAD_BYTES=32768
# Bound one Redis call so a slow/remote counter store fails fast instead of queueing requests.
REDIS_TIMEOUT_MS=2000
REDIS_POOL_SIZE=50
# Async produce: HTTP 202 after enqueue; a background producer batches 500-5000 events.
# Queue-full sheds load with 429 + Retry-After instead of a multi-second request.
EDGE_ASYNC_PRODUCE=true
EDGE_QUEUE_MAX_EVENTS=10000
EDGE_PRODUCE_BATCH_MIN=500
EDGE_PRODUCE_BATCH_MAX=5000
EDGE_PRODUCE_FLUSH_MS=50
EDGE_PRODUCE_MAX_ATTEMPTS=5
EDGE_PRODUCE_RETRY_BACKOFF_MS=100
# Confirm event claims off the request path. Off guarantees claims are confirmed
# before the 202 but adds one Redis round trip; on adds latency headroom.
EDGE_ASYNC_CONFIRM=true
# --- Scale features (docs/INGESTION_SCALE_ARCHITECTURE.md). All off by default. ---
# Disk spill: events Kafka cannot take go to this directory and are replayed, not dropped or 429'd.
# EDGE_WAL_DIR=./.edge-wal
# EDGE_WAL_MAX_MB=4096
# Adaptive cap on in-flight requests by observed latency; refuses the excess with 503 + jittered Retry-After.
# EDGE_ADAPTIVE_LIMIT=false
# Leased admission: no Redis call per request. SITE_EVENTS_PER_SEC is one site's budget across the whole
# fleet (events/s, replaces SITE_RATE_LIMIT_MAX); EDGE_FLEET_SIZE is the number of edge instances.
# EDGE_LEASES=false
# SITE_EVENTS_PER_SEC=2000
# EDGE_FLEET_SIZE=1
# Under queue/WAL pressure keep 1-in-N web vitals and ask SDKs to slow down (X-GI-Backoff).
# EDGE_SHED=false
# Confine each site to K Kafka partitions (shuffle sharding). 0 = spread over all.
# KAFKA_SHUFFLE_K=0
# Bounds one background Kafka attempt. The request no longer waits on it.
KAFKA_PUBLISH_TIMEOUT_MS=10000
# Reverse proxies in front of the edge (CDN, load balancer). The edge reads the client IP
# this many entries from the right of X-Forwarded-For. Use 0 if the edge is exposed
# directly; a wrong value either lets clients spoof their IP or makes everyone share the proxy's.
TRUSTED_PROXY_HOPS=1

# First-party ingest proxy (services/ingest-proxy). Both are required there.
# SIGNING_SECRET=gis_...
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Workers
# ClickHouse may hold rows up to this long to build larger parts (async insert; the worker waits for the flush)
EVENT_FLUSH_INTERVAL_MS=1000
CLICKHOUSE_ASYNC_INSERT=true
# Worker write target for the events_v2 migration: off | shadow | only.
# shadow keeps legacy authoritative and fills events_ingest -> events_v2 and the aggregate MVs.
WORKER_WRITE_V2=shadow
# How often the worker samples consumer-group lag from the Kafka admin API (ms).
WORKER_LAG_SAMPLE_MS=5000
# Prometheus port for the scheduled worker (0 disables)
SCHEDULER_METRICS_PORT=9465
# Analytics read source: v1 | v2 | shadow (run both, return v1, log differences)
ANALYTICS_READ=v1
# Comma-separated dashboard features to show (e.g. errors,retention,segments). Empty = only shipped pages.
FEATURE_FLAGS=
# Writer fetch tuning: large insert blocks (about 1 MB, at most 500 ms wait). The live view has its own consumer and is not slowed by this.
WORKER_FETCH_MIN_BYTES=1000000
WORKER_FETCH_MAX_WAIT_MS=500
# writer = Kafka -> ClickHouse; realtime = Kafka -> Redis live view (own consumer group). Split to scale separately.
WORKER_ROLES=writer,realtime
WORKER_FETCH_MAX_BYTES_PER_PARTITION=8000000
WORKER_PARTITION_CONCURRENCY=4
# Prometheus /metrics for the event worker (internal network only); 0 disables
WORKER_METRICS_PORT=9464
# Web app Prometheus scrape (/api/internal/metrics, Bearer token). Unset = endpoint disabled
# METRICS_TOKEN=

# Privacy & Geolocation
DERIVE_GEO_AT_EDGE=true
STORE_RAW_IP=false
DEFAULT_RETENTION_MONTHS=24

# Rollup jobs: days recomputed before today on every run, how far back a lagging table is repaired,
# and the most days one run will process while catching up.
ROLLUP_LOOKBACK_DAYS=2
ROLLUP_BACKFILL_DAYS=65
ROLLUP_MAX_DAYS_PER_RUN=14
# Optional MaxMind / DB-IP MMDB for edge geo when CDN headers are absent
# Run `node scripts/download-geoip.mjs` to fetch the free DB-IP city database (CC BY 4.0,
# attribution: https://db-ip.com). Path is relative to services/ingestion-go.
# GEOIP_MMDB_PATH=../../infra/geoip/dbip-city-lite.mmdb
# Development only: locate loopback/private clients (every local request) as this public IP.
# The service refuses to start with it set when NODE_ENV=production.
# GEO_LOOPBACK_IP=

# Public URLs used by the shared landing page across both apps.
# Replace these with your deployed origins in production.
NEXT_PUBLIC_DOCS_URL=http://localhost:3002
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# --- Security settings (docs/SECURITY_AUDIT.md) ---
# Number of reverse proxies in front of the ingestion edge and the web app (0 = clients connect directly).
# REQUIRED in production for the edge; the web app uses it to find the real client address for rate limits.
# TRUSTED_PROXY_HOPS=1
# Production refuses to start the edge with /metrics on the public port unless METRICS_PORT is set (preferred)
# or you accept it explicitly:
# ALLOW_PUBLIC_METRICS=false
# Content-Security-Policy rollout: report-only (default) -> enforce once /api/security/csp-report is clean. off disables.
# CSP_MODE=report-only
# Secret encryption key rotation (see scripts/rotate-secrets.ts): the new key goes in SITE_SIGNING_SECRET_KEY,
# the old one(s) here, comma separated, until `rotate-secrets --apply` has re-encrypted everything.
# SITE_SIGNING_SECRET_KEY_PREVIOUS=
# Per user / per API key requests per minute across all authenticated endpoints.
# API_RATE_LIMIT_PER_MINUTE=600
# Refuse signed ingestion requests that lack X-GI-Timestamp (replay protection). Turn on after the edge, the
# ingest-proxy and the tracker are all updated; deploy the edge first.
# SIGNING_REQUIRE_TIMESTAMP=false
# Sharing the session cookie with sibling subdomains widens the trust boundary; production requires the ack.
# SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_SHARED_ACK=false
