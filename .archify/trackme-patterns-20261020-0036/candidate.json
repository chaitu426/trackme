  "cards": [
    {
      "dot": "cyan",
      "title": "Resilient event delivery",
      "items": [
        "The consumer validates a batch, isolates individual ClickHouse row failures, and sends rejects to the DLQ.",
        "Offsets resolve only after the ClickHouse write and required DLQ sends succeed; a failed step causes Kafka redelivery.",
        "event_id plus ReplacingMergeTree makes replayed inserts converge during merges; this is at-least-once delivery, not end-to-end exactly-once."
      ]
    },
    {
      "dot": "emerald",
      "title": "Fast, bounded state",
      "items": [
        "A Redis Lua script increments a time-bucketed counter and repairs/sets expiry atomically in one server-side operation.",
        "The consumer pipelines active-session TTL keys, a sorted-set index and per-site notifications.",
        "Scheduled jobs use Redis locks to avoid duplicate work across worker replicas."
      ]
    },
    {
      "dot": "violet",
      "title": "Explicit boundaries",
      "items": [
        "Go handler interfaces invert dependencies so Redis, PostgreSQL and Kafka failure paths can be tested with substitutes.",
        "Shared tenant context checks role permissions and workspace identity before protected operations.",
        "PostgreSQL serves operational records while ClickHouse serves analytical scans: a useful CQRS-like workload split, not a claim of strict CQRS."
      ]
    }
  ]
