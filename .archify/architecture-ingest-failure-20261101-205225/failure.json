  "cards": [
    {
      "dot": "rose",
      "title": "Admission failed open",
      "items": [
        "97% of requests: Redis EVAL exceeded the 3 s read timeout",
        "Rate limit, edge dedupe and quota were bypassed silently",
        "One metric label op=gate covers both the IP limiter and the gate"
      ]
    },
    {
      "dot": "amber",
      "title": "Producer lost and mis-counted events",
      "items": [
        "About 27% of offered events never reached Kafka",
        "Only 1,714 of 14,412 landed messages were acked",
        "Ambiguous acks=all timeouts released claims and quota"
      ]
    },
    {
      "dot": "orange",
      "title": "Throughput collapsed",
      "items": [
        "Produce p50 4 s at 10 concurrent, 11 s at 50",
        "Delivered about 30 events/s; 2 partitions cap the worker",
        "Sync acks=all keeps Kafka in the request path"
      ]
    },
    {
      "dot": "violet",
      "title": "Backlog went dark",
      "items": [
        "6,252 messages were unconsumed when the run stopped",
        "Lag gauge updates only per batch, so it read 0",
        "WORKER_WRITE_V2=off leaves events_v2 aggregates empty"
      ]
    }
  ]
