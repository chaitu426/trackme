      "versionNonce": 2029643540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794212234868,
      "link": null,
      "locked": false,
      "text": "Workers send 1 SET per session + 4 commands per site per batch (about 70% fewer Redis commands). One PUBLISH per site,\ntiny and payload-free. A node with no viewers receives zero messages. Fallback poll is jittered +/-20%; max 200\nlisteners per site per node; SSE heartbeat every 25 s.",
      "originalText": "Workers send 1 SET per session + 4 commands per site per batch (about 70% fewer Redis commands). One PUBLISH per site,\ntiny and payload-free. A node with no viewers receives zero messages. Fallback poll is jittered +/-20%; max 200\nlisteners per site per node; SSE heartbeat every 25 s.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b2e"
