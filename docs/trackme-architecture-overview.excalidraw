7, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e265", "type": "rectangle", "x": 1606.78, "y": 2225.25, "width": 99.22, "height": 28, "angle": 0, "strokeColor": "#c2255c", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 555248245, "version": 1, "versionNonce": 538776710, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e266", "type": "text", "x": 1606.78, "y": 2231.25, "width": 99.22, "height": 16.25, "angle": 0, "strokeColor": "#c2255c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 592043408, "version": 1, "versionNonce": 731965012, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "ECS Fargate", "originalText": "ECS Fargate", "fontSize": 13, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "baseline": 11, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e267", "type": "rectangle", "x": 1830, "y": 2239.25, "width": 380, "height": 177.75, "angle": 0, "strokeColor": "#c2255c", "backgroundColor": "#ffdeeb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g36"], "frameId": null, "roundness": {"type": 3}, "seed": 892681580, "version": 1, "versionNonce": 213974619, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e268", "type": "text", "x": 1848, "y": 2257.25, "width": 344, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "