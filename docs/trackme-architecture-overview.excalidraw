    },
    {
      "id": "e195",
      "type": "text",
      "x": 1098,
      "y": 1428.5,
      "width": 604,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "g25"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 610059350,
      "version": 2,
      "versionNonce": 542129044,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794210710272,
      "link": null,
      "locked": false,
      "text": "Key q:v1:endpoint:site:hash(request). Rolling ranges are floored\nto 1 min (<= 48 h) or 5 min so keys repeat. TTL 30 s for live\nranges, 15 min for closed ones. Identical concurrent queries\ncoalesce into one. Errors are never cached; Redis down means a\ndirect query.",
      "originalText": "Key q:v1:endpoint:site:hash(request). Rolling ranges are floored\nto 1 min (<= 48 h) or 5 min so keys repeat. TTL 30 s for live\nranges, 15 min for closed ones. Identical concurrent queries\ncoalesce into one. Errors are never cached; Redis down means a\ndirect query.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "lineHeight": 1.25,
