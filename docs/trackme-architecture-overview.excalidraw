Size": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e318", "type": "text", "x": 758, "y": 3126.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g49"], "frameId": null, "roundness": null, "seed": 738091257, "version": 1, "versionNonce": 1061728270, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Query failure is a 502, not a zeroed chart. Redis outage fails\nadmission closed (503). A failed session check closes.", "originalText": "Query failure is a 502, not a zeroed chart. Redis outage fails\nadmission closed (503). A failed session check closes.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e319", "type": "rectangle", "x": 1395, "y": 3075.0, "width": 620, "height": 109.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g50"], "frameId": null, "roundness": {"type": 3}, "seed": 286393791, "version": 1, "versionNonce": 159658222, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e320", "type": "text", "x": 1413, "y": 3093.0, "width": 584, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g50"], "frameId": null, "roundness": null, "seed": 257243890, "version": 1, "versionNonce": 960589968, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D3 Absorb, do not drop", "originalText": "D3 Absorb, do not drop", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e321", "type": "text", "x": 1413, "y": 3126.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g50"], "frameId": null, "roundness": null, "seed": 457767612, "version": 1, "versionNonce": 954209952, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Bounded queue, then WAL, then Kafka. Overload becomes an explicit\n503/429 with Retry-After, never silent loss.", "originalText": "Bounded queue, then WAL, then Kafka. Overload becomes an explicit\n503/429 with Retry-After, never silent loss.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e322", "type": "rectangle", "x": 2050, "y": 3075.0, "width": 620, "height": 109.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g51"], "frameId": null, "roundness": {"type": 3}, "seed": 911306877, "version": 1, "versionNonce": 554205936, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e323", "type": "text", "x": 2068, "y": 3093.0, "width": 584, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g51"], "frameId": null, "roundness": null, "seed": 837788390, "version": 1, "versionNonce": 323593815, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D4 Big synchronous inserts + dedupe token", "originalText": "D4 Big synchronous inserts + dedupe token", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e324", "type": "text", "x": 2068, "y": 3126.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g51"], "frameId": null, "roundness": null, "seed": 792314088, "version": 1, "versionNonce": 329566926, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "About one 10k-100k row insert per second per worker; token =\ntopic:partition:offsets; async insert off.", "originalText": "About one 10k-100k row insert per second per worker; token =\ntopic:partition:offsets; async insert off.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e325", "type": "rectangle", "x": 2705, "y": 3075.0, "width": 620, "height": 109.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g52"], "frameId": null, "roundness": {"type": 3}, "seed": 698771024, "version": 1, "versionNonce": 624672227, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e326", "type": "text", "x": 2723, "y": 3093.0, "width": 584, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g52"], "frameId": null, "roundness": null, "seed": 394852167, "version": 1, "versionNonce": 918376867, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D5 Compute once, at insert time", "originalText": "D5 Compute once, at insert time", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e327", "type": "text", "x": 2723, "y": 3126.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g52"], "frameId": null, "roundness": null, "seed": 792980910, "version": 1, "versionNonce": 208342291, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Materialized views maintain aggregates incrementally. No rollup\njobs rescanning raw events; reads merge states.", "originalText": "Materialized views maintain aggregates incrementally. No rollup\njobs rescanning raw events; reads merge states.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e328", "type": "rectangle", "x": 85, "y": 3214.0, "width": 620, "height": 109.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g53"], "frameId": null, "roundness": {"type": 3}, "seed": 992172336, "version": 1, "versionNonce": 696114542, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e329", "type": "text", "x": 103, "y": 3232.0, "width": 584, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g53"], "frameId": null, "roundness": null, "seed": 168593826, "version": 1, "versionNonce": 178287156, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D6 Bound every query", "originalText": "D6 Bound every query", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e330", "type": "text", "x": 103, "y": 3265.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g53"], "frameId": null, "roundness": null, "seed": 927688103, "version": 1, "versionNonce": 1041222175, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Cache + single-flight + read-only profile limits. Authorize before\nthe cache so a hit never skips access control.", "originalText": "Cache + single-flight + read-only profile limits. Authorize before\nthe cache so a hit never skips access control.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e331", "type": "rectangle", "x": 740, "y": 3214.0, "width": 620, "height": 109.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": {"type": 3}, "seed": 995385158, "version": 1, "versionNonce": 641819887, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e332", "type": "text", "x": 758, "y": 3232.0, "width": 584, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 19955789, "version": 1, "versionNonce": 163379049, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D7 Realtime off the analytics store", "originalText": "D7 Realtime off the analytics store", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e333", "type": "text", "x": 758, "y": 3265.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 666033037, "version": 1, "versionNonce": 457973137, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Redis only: batched writes, per-site subscribe, nodes with no\nviewers get nothing.", "originalText": "Redis only: batched writes, per-site subscribe, nodes with no\nviewers get nothing.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e334", "type": "rectangle", "x": 1395, "y": 3214.0, "width": 620, "height": 109.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": {"type": 3}, "seed": 175468586, "version": 1, "versionNonce": 652416778, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e335", "type": "text", "x": 1413, "y": 3232.0, "width": 584, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 1062491702, "version": 1, "versionNonce": 704265849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D8 Cheap but revocable authorization", "originalText": "D8 Cheap but revocable authorization", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e336", "type": "text", "x": 1413, "y": 3265.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 607555716, "version": 1, "versionNonce": 306914340, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Short-lived caches invalidated by direct DEL; sessions_valid_after\nmarker makes revoke-all instant.", "originalText": "Short-lived caches invalidated by direct DEL; sessions_valid_after\nmarker makes revoke-all instant.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e337", "type": "rectangle", "x": 2050, "y": 3214.0, "width": 620, "height": 109.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": {"type": 3}, "seed": 469767838, "version": 1, "versionNonce": 768373174, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e338", "type": "text", "x": 2068, "y": 3232.0, "width": 584, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g56"], "frameId": null, "roundness": null, "seed": 702368691, "version": 1, "versionNonce": 78682609