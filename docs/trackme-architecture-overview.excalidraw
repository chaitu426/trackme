 1, "versionNonce": 52193982, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "C  REALTIME: how live numbers reach the screen (never queries ClickHouse)", "originalText": "C  REALTIME: how live numbers reach the screen (never queries ClickHouse)", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 28, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e221", "type": "text", "x": 90, "y": 1760.75, "width": 1030.3200000000002, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 80392914, "version": 1, "versionNonce": 1033534317, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Workers do tiny batched Redis writes; each web node subscribes only to the sites its viewers are watching.", "originalText": "Workers do tiny batched Redis writes; each web node subscribes only to the sites its viewers are watching.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e222", "type": "rectangle", "x": 100, "y": 1817.75, "width": 380, "height": 156.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g28"], "frameId": null, "roundness": {"type": 3}, "seed": 314724082, "version": 1, "versionNonce": 407100925, "isDeleted": false, "boundElements": [{"id": "e250", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "e223", "type": "text", "x": 118, "y": 1835.75, "width": 344, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWi