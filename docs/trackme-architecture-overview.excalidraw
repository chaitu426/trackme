 1, "versionNonce": 654476870, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D10 Reversible rollout", "originalText": "D10 Reversible rollout", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e342", "type": "text", "x": 2723, "y": 3265.0, "width": 584, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g57"], "frameId": null, "roundness": null, "seed": 984139936, "version": 1, "versionNonce": 682082137, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Feature flags, shadow write, shadow read, nightly reconciliation;\nlegacy tables live until proven.", "originalText": "Feature flags, shadow write, shadow read, nightly reconciliation;\nlegacy tables live until proven.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}