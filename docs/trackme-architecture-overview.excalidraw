    {
      "id": "e227",
      "type": "text",
      "x": 592.6410694730505,
      "y": 1868.1782138946103,
      "width": 1094,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
