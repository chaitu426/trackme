      "boundElements": [],
      "updated": 1794210710273,
      "link": null,
      "locked": false,
      "text": "Shadow write (WORKER_WRITE_V2) > backfill by received_at > shadow read (ANALYTICS_READ=shadow, zero\nunexplained diffs for 7 days) > cutover to v2 > keep *_old 14 days > drop. Every phase has a feature\nflag and a rollback.",
      "originalText": "Shadow write (WORKER_WRITE_V2) > backfill by received_at > shadow read (ANALYTICS_READ=shadow, zero\nunexplained diffs for 7 days) > cutover to v2 > keep *_old 14 days > drop. Every phase has a feature\nflag and a rollback.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
