toResize": true}, {"id": "e218", "type": "text", "x": 1698, "y": 2560.75, "width": 704, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g50"], "frameId": null, "roundness": null, "seed": 737653974, "version": 1, "versionNonce": 405890064, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every ~2 s roll the segment, publish oldest-first, delete a segment only after\nKafka acks.", "originalText": "Every ~2 s roll the segment, publish oldest-first, delete a segment only after\nKafka acks.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e219", "type": "rectangle", "x": 2470, "y": 2508.5, "width": 740, "height": 110.25, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g51"], "frameId": null, "roundness": {"type": 3}, "seed": 151509544, "version": 1, "versionNonce": 1035245166, "isDeleted": false, "boundElements": [{"id": "e224", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "e220", "type": "text", "x": 2488, "y": 2526.5, "width": 704, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g51"], "frameId": null, "roundness": null, "seed": 228005484, "version": 1, "versionNonce": 52193982, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Back to Kafka", "originalText": "Back to Kafka", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e221", "type": "text", "x": 2488, "y": 2560.75, "width": 704, "height": 40.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g51"], "frameId": null, "roundness": null, "seed": 80392914, "version": 1, "versionNonce": 1033534317, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "After a crash mid-segment some events can be re-published: absorbed by the worker\ntoken and the nightly duplicate-rate job.", "originalText": "After a crash mid-segment some events can be re-published: absorbed by the worker\ntoken and the nightly duplicate-rate job.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e222", "type": "arrow", "x": 840, "y": 2563.625, "width": 50, "height": 0.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 314724082, "version": 1, "versionNonce": 407100925, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0.0], [50, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e210", "focus": 0, "gap": 2}, "endBinding": {"elementId": "e213", "focus": 0, "gap": 2}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e223", "type": "arrow", "x": 1630, "y": 2563.625, "width": 50, "height": 0.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 396288683, "version": 1, "versionNonce": 246846794, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0.0], [50, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e213", "focus": 0, "gap": 2}, "endBinding": {"elementId": "e216", "focus": 0, "gap": 2}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e224", "type": "arrow", "x": 2420, "y": 2563.625, "width": 50, "height": 0.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 437902024, "version": 1, "versionNonce": 370423004, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0.0], [50, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "e216", "focus": 0, "gap": 2}, "endBinding": {"elementId": "e219", "focus": 0, "gap": 2}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "e225", "type": "text", "x": 100, "y": 2668.75, "width": 238.68, "height": 32.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 339360974, "version": 1, "versionNonce": 607940693, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "When things break", "originalText": "When things break", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 23, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e226", "type": "rectangle", "x": 100, "y": 2716.75, "width": 740, "height": 150.25, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g52"], "frameId": null, "roundness": {"type": 3}, "seed": 204540134, "version": 1, "versionNonce": 133026061, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e227", "type": "text", "x": 118, "y": 2734.75, "width": 704, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g52"], "frameId": null, "roundness": null, "seed": 288729729, "version": 1, "versionNonce": 992289371, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "If ClickHouse is down", "originalText": "If ClickHouse is down", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e228", "type": "text", "x": 118, "y": 2769.0, "width": 704, "height": 80.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g52"], "frameId": null, "roundness": null, "seed": 166656898, "version": 1, "versionNonce": 207691641, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The insert throws before any offset is resolved, so the writer commits nothing\nand Kafka redelivers. Consumer lag grows while Kafka retains. When ClickHouse\nreturns, the same batch is inserted with the same token. Nothing is dropped;\ninserts never wait on a degraded realtime path.", "originalText": "The insert throws before any offset is resolved, so the writer commits nothing\nand Kafka redelivers. Consumer lag grows while Kafka retains. When ClickHouse\nreturns, the same batch is inserted with the same token. Nothing is dropped;\ninserts never wait on a degraded realtime path.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e229", "type": "rectangle", "x": 890, "y": 2716.75, "width": 740, "height": 150.25, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g53"], "frameId": null, "roundness": {"type": 3}, "seed": 701856220, "version": 1, "versionNonce": 839417796, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e230", "type": "text", "x": 908, "y": 2734.75, "width": 704, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g53"], "frameId": null, "roundness": null, "seed": 1002788676, "version": 1, "versionNonce": 915780256, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "If a worker crashes or the group rebalances", "originalText": "If a worker crashes or the group rebalances", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e231", "type": "text", "x": 908, "y": 2769.0, "width": 704, "height": 80.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g53"], "frameId": null, "roundness": null, "seed": 761433701, "version": 1, "versionNonce": 923592458, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The next consumer reads from the last committed offset and re-cuts its first\nbatch. An identical batch is dropped by the dedupe token. If the batch boundaries\ndiffer, a duplicate can land; the nightly job measures it (target <= 0.01%) and\nrepairs by partition.", "originalText": "The next consumer reads from the last committed offset and re-cuts its first\nbatch. An identical batch is dropped by the dedupe token. If the batch boundaries\ndiffer, a duplicate can land; the nightly job measures it (target <= 0.01%) and\nrepairs by partition.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e232", "type": "rectangle", "x": 1680, "y": 2716.75, "width": 740, "height": 150.25, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": {"type": 3}, "seed": 451154386, "version": 1, "versionNonce": 801341988, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e233", "type": "text", "x": 1698, "y": 2734.75, "width": 704, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 28445578, "version": 1, "versionNonce": 87784070, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "If Kafka is down or slow at the edge", "originalText": "If Kafka is down or slow at the edge", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e234", "type": "text", "x": 1698, "y": 2769.0, "width": 704, "height": 60.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g54"], "frameId": null, "roundness": null, "seed": 430078636, "version": 1, "versionNonce": 389272618, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Events stay in the 10k in-memory queue; when it fills they spill to the WAL if\nenabled, otherwise requests get an explicit 429. Without a WAL the edge frees\nclaims and quota so the SDK retries instead of losing or double counting.", "originalText": "Events stay in the 10k in-memory queue; when it fills they spill to the WAL if\nenabled, otherwise requests get an explicit 429. Without a WAL the edge frees\nclaims and quota so the SDK retries instead of losing or double counting.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e235", "type": "rectangle", "x": 2470, "y": 2716.75, "width": 740, "height": 150.25, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": {"type": 3}, "seed": 876078517, "version": 1, "versionNonce": 974852318, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e236", "type": "text", "x": 2488, "y": 2734.75, "width": 704, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 772166651, "version": 1, "versionNonce": 794985241, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Scaling the pipeline", "originalText": "Scaling the pipeline", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e237", "type": "text", "x": 2488, "y": 2769.0, "width": 704, "height": 60.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g55"], "frameId": null, "roundness": null, "seed": 870379615, "version": 1, "versionNonce": 419029695, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Edge: add ECS tasks (stateless), watch queue depth and publish errors. Workers:\nreplicas <= partitions, scale on lag. Kafka: more partitions = more parallel\nwriters. ClickHouse: big blocks (~1 MB) keep part count and merge load low.", "originalText": "Edge: add ECS tasks (stateless), watch queue depth and publish errors. Workers:\nreplicas <= partitions, scale on lag. Kafka: more partitions = more parallel\nwriters. ClickHouse: big blocks (~1 MB) keep part count and merge load low.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e238", "type": "rectangle", "x": 60, "y": 2967.0, "width": 3290, "height": 1050.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#fcfcfd", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 354499444, "version": 1, "versionNonce": 203585001, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e239", "type": "text", "x": 90, "y": 2989.0, "width": 708.48, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 33109171, "version": 1, "versionNonce": 695133399, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4  ClickHouse data model and read sources", "originalText": "4  ClickHouse data model and read sources", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 28, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e240", "type": "text", "x": 90, "y": 3035.0, "width": 1253.88, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 182160544, "version": 1, "versionNonce": 868678432, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Events are written once; every aggregate is maintained by materialized views. Reads never use FINAL and never rescan raw history.", "originalText": "Events are written once; every aggregate is maintained by materialized views. Reads never use FINAL and never rescan raw history.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e241", "type": "text", "x": 100, "y": 3107.0, "width": 828.36, "height": 32.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 410057367, "version": 1, "versionNonce": 732237256, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Write path inside ClickHouse (compute once, at insert time)", "originalText": "Write path inside ClickHouse (compute once, at insert time)", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 23, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e242", "type": "rectangle", "x": 100, "y": 3155.0, "width": 470, "height": 170.25, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "st