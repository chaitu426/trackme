ted": 1, "link": null, "locked": false}, {"id": "e139", "type": "text", "x": 118, "y": 1587.0, "width": 1504, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g33"], "frameId": null, "roundness": null, "seed": 958810154, "version": 1, "versionNonce": 234119103, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Status codes the SDK sees", "originalText": "Status codes the SDK sees", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 19, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e140", "type": "text", "x": 118, "y": 1622.5, "width": 1504, "height": 42.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g33"], "frameId": null, "roundness": null, "seed": 791740914, "version": 1, "versionNonce": 167435849, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "202 queued. 400 / 401 / 402 / 403: the SDK drops the events (resending would get the same answer). 408 / 429 / 5xx: retry with back-off and the Retry-After /\nX-GI-Backoff hints. A full queue or an exceeded limit is always an explicit answer, never silent loss.", "originalText": "202 queued. 400 / 401 / 402 / 403: the SDK drops the events (resending would get the same answer). 408 / 429 / 5xx: retry with back-off and the Retry-After /\nX-GI-Backoff hints. A full queue or an exceeded limit is always an explicit answer, never silent loss.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e141", "type": "rectangle", "x": 1700, "y": 1569.0, "width": 1540, "height": 114.0, "angle"