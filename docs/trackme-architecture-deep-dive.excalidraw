": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e351", "type": "text", "x": 118, "y": 4800.75, "width": 434, "height": 60.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g83"], "frameId": null, "roundness": null, "seed": 192714440, "version": 1, "versionNonce": 975750441, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Batch collapsed to the latest event per (site,\nsession) first, so a burst of 50 events from one\nvisitor is one update.", "originalText": "Batch collapsed to the latest event per (site,\nsession) first, so a burst of 50 events from one\nvisitor is one update.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e352", "type": "rectangle", "x": 630, "y": 4748.5, "width": 470, "height": 150.25, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": {"type": 3}, "seed": 604419877, "version": 1, "versionNonce": 47738757, "isDeleted": false, "boundElements": [{"id": "e369", "type": "arrow"}, {"id": "e370", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "e353", "type": "text", "x": 648, "y": 4766.5, "width": 434, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g84"], "frameId": null, "roundness": null, "seed": 475109619, "version": 1, "versionNonce": 123969020, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 Redis writes", "originalText": "