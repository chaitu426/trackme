rsion": 1, "versionNonce": 869209393, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "10k events, flushed every 50 ms or 500 events. A shock absorber\nfor bursts. Full means spill to the WAL, not drop.", "originalText": "10k events, flushed every 50 ms or 500 events. A shock absorber\nfor bursts. Full means spill to the WAL, not drop.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e116", "type": "rectangle", "x": 1370, "y": 1398.75, "width": 590, "height": 130.25, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["g30"], "frameId": null, "roundness": {"type": 3}, "seed": 538157907, "version": 1, "versionNonce": 426287912, "isDeleted": false, "boundElements": [{"id": "e135", "type": "arrow"}, {"id": "e136", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "e117", "type": "text", "x": 1388, "y": 1416.75, "width": 554, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g30"], "frameId": null, "roundness": null, "seed": 925340563, "version": 1, "versionNonce": 430123545, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "8 Disk WAL", "originalText": "8 Disk WAL", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e118", "type": "text", "x": 1388, "y": 1451.0, "width": 554, "height": 60.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "group