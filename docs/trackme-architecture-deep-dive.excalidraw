od: EDGE_ADAPTIVE_LIMIT, EDGE_SHED, EDGE_WAL_DIR, EDGE_LEASES, KAFKA_SHUFFLE_K, SIGNING_REQUIRE_TIMESTAMP.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 15, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e144", "type": "rectangle", "x": 60, "y": 1753.0, "width": 3290, "height": 1164.0, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#fcfcfd", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1014040706, "version": 1, "versionNonce": 77685246, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "e145", "type": "text", "x": 90, "y": 1775.0, "width": 1123.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 384611762, "version": 1, "versionNonce": 486311873, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3  Queue and delivery path: edge queue > Kafka > workers > stores", "originalText": "3  Queue and delivery path: edge queue > Kafka > workers > stores", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 28, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e146", "type": "text", "x": 90, "y": 1821.0, "width": 1662.1200000000001, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 584877767, "version": 1, "versionNonce": 742469995, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "At-least-once end to end. Duplicates are removed by event id (edge claim), the ClickHouse insert token and the nightly reconciliation. 'Never silent loss' is the contract.", "originalText": "At-least-once end to end. Duplicates are removed by event id (edge claim), the ClickHouse insert token and the nightly reconciliation. 'Never silent loss' is the contract.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e147", "type": "text", "x": 100, "y": 1893.0, "width": 252.72000000000003, "height": 32.5, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 341863000, "version": 1, "versionNonce": 845069618, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Main delivery path", "originalText": "Main delivery path", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 23, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e148", "type": "rectangle", "x": 100, "y": 1941.0, "width": 470, "height": 150.25, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g35"], "frameId": null, "roundness": {"type": 3}, "seed": 480870581, "version": 1, "versionNonce": 187281319, "isDeleted": false, "boundElements": [{"id": "e198", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "e149", "type": "text", "x": 118, "y": 1959.0, "width": 434, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g35"], "frameId": null, "roundness": null, "seed": 881503846, "version": 1, "versionNonce": 833163948, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1 HTTP handler", "originalText": "1 HTTP handler", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e150", "type": "text", "x": 118, "y": 1993.25, "width": 434, "height": 60.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g35"], "frameId": null, "roundness": null, "seed": 278979433, "version": 1, "versionNonce": 967447711, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Each request's goroutine appends its admitted\nevents to the queue and replies 202 without\nwaiting for Kafka.", "originalText": "Each request's goroutine appends its admitted\nevents to the queue and replies 202 without\nwaiting for Kafka.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e151", "type": "rectangle", "x": 630, "y": 1941.0, "width": 470, "height": 150.25, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g36"], "frameId": null, "roundness": {"type": 3}, "seed": 973961483, "version": 1, "versionNonce": 422789564, "isDeleted": false, "boundElements": [{"id": "e198", "type": "arrow"}, {"id": "e199", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "e152", "type": "text", "x": 648, "y": 1959.0, "width": 434, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "grou