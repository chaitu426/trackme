   "width": 616,
   "height": 21.25,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Scaling the pipeline",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Scaling the pipeline",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 3880310,
   "version": 1,
   "versionNonce": 51317210,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "t490",
   "x": 2052,
   "y": 3248,
   "width": 616,
   "height": 130,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Edge: add ECS tasks (stateless), watch queue depth,\npublish outcomes, concurrency limit.\nWorkers: replicas x 4 partitions <= topic partitions.\nSplit WORKER_ROLES: writer replicas for throughput,\nrealtime replicas for freshness.\nKafka: more partitions = more parallel writers; shuffle\nsharding (KAFKA_SHUFFLE_K) limits one noisy site's blast radius.\nClickHouse: big blocks (~1 MB) keep part count under merge capacity.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Edge: add ECS tasks (stateless), watch queue depth,\npublish outcomes, concurrency limit.\nWorkers: replicas x 4 partitions <= topic partitions.\nSplit WORKER_ROLES: writer replicas for throughput,\nrealtime replicas for freshness.\nKafka: more partitions = more parallel writers; shuffle\nsharding (KAFKA_SHUFFLE_K) limits one noisy site's blast radius.\nClickHouse: big blocks (~1 MB) keep part count under merge capacity.",
   "lineHeight": 1.25,
   "autoResize": false
  },
