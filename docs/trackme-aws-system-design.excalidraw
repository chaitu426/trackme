   "type": "text",
   "id": "t333",
   "x": 1352,
   "y": 2238,
   "width": 1296,
   "height": 48.75,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "202 queued/stored.   400, 401, 402, 403: SDK drops the events (resending gets the same answer).\n408, 429, 5xx: SDK retries with backoff and the Retry-After / X-GI-Backoff hints.\nQueue-full and over-limit are explicit answers, never silent loss.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "202 queued/stored.   400, 401, 402, 403: SDK drops the events (resending gets the same answer).\n408, 429, 5xx: SDK retries with backoff and the Retry-After / X-GI-Backoff hints.\nQueue-full and over-limit are explicit answers, never silent loss.",
   "lineHeight": 1.25,
   "autoResize": false
  },
