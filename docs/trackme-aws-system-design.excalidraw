   "id": "t330",
   "x": 52,
   "y": 2238,
   "width": 1256,
   "height": 32.5,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "ON: EDGE_ASYNC_PRODUCE (queue), EDGE_GATE_SCRIPT (fused Redis script), EDGE_DEDUPE, EDGE_ASYNC_CONFIRM, ADMISSION_FAIL_CLOSED\nOFF (enable in prod after load test): EDGE_ADAPTIVE_LIMIT, EDGE_SHED, EDGE_WAL_DIR, EDGE_LEASES, KAFKA_SHUFFLE_K, SIGNING_REQUIRE_TIMESTAMP",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ON: EDGE_ASYNC_PRODUCE (queue), EDGE_GATE_SCRIPT (fused Redis script), EDGE_DEDUPE, EDGE_ASYNC_CONFIRM, ADMISSION_FAIL_CLOSED\nOFF (enable in prod after load test): EDGE_ADAPTIVE_LIMIT, EDGE_SHED, EDGE_WAL_DIR, EDGE_LEASES, KAFKA_SHUFFLE_K, SIGNING_REQUIRE_TIMESTAMP",
   "lineHeight": 1.25,
   "autoResize": false
  },
