   "id": "t480",
   "x": 52,
   "y": 3220,
   "width": 626,
   "height": 21.25,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "If ClickHouse is down",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If ClickHouse is down",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 3809039,
   "version": 1,
   "versionNonce": 50374649,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "t481",
   "x": 52,
   "y": 3248,
   "width": 626,
   "height": 130,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "insert throws before any offset is resolved,\nso the writer commits nothing and Kafka redelivers.\nConsumer lag grows (sampled every 5 s) while the edge\nkeeps accepting events: Kafka is the buffer.\nWhen ClickHouse returns the same batch is inserted\nonce: ReplacingMergeTree on event_id + insert token.\nA single refused row is isolated and dead-lettered\ninstead of blocking the batch.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "insert throws before any offset is resolved,\nso the writer commits nothing and Kafka redelivers.\nConsumer lag grows (sampled every 5 s) while the edge\nkeeps accepting events: Kafka is the buffer.\nWhen ClickHouse returns the same batch is inserted\nonce: ReplacingMergeTree on event_id + insert token.\nA single refused row is isolated and dead-lettered\ninstead of blocking the batch.",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 3816958,
   "version": 1,
   "versionNonce": 50479378,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "rectangle",
   "id": "k482",
   "x": 710,
   "y": 3210,
   "width": 650,
   "height": 270,
   "strokeColor": "#6741d9",
   "backgroundColor": "#f8f9fa",
   "strokeStyle": "dashed",
   "roundness": {
    "type": 3
   }
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 3824877,
   "version": 1,
   "versionNonce": 50584107,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "t483",
   "x": 722,
   "y": 3220,
   "width": 626,
   "height": 21.25,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "If a worker crashes or the group rebalances",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If a worker crashes or the group rebalances",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 3832796,
   "version": 1,
   "versionNonce": 50688836,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "t484",
   "x": 722,
   "y": 3248,
   "width": 626,
   "height": 113.75,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "intent [first,last] was written before the INSERT.\nThe next consumer reads it and re-cuts its first batch to\nexactly that range, so the batch (and the token) is\nidentical and ClickHouse drops the duplicate block,\nincluding in the dependent materialized views.\nIf the Redis intent store is down the batch proceeds\n(500 ms timeout): exactness degrades, liveness does not.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "intent [first,last] was written before the INSERT.\nThe next consumer reads it and re-cuts its first batch to\nexactly that range, so the batch (and the token) is\nidentical and ClickHouse drops the duplicate block,\nincluding in the dependent materialized views.\nIf the Redis intent store is down the batch proceeds\n(500 ms timeout): exactness degrades, liveness does not.",
   "lineHeight": 1.25,
   "autoResize": false
  },
