   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "GeoIP (dbip-city-lite.mmdb): country / region / city. User-agent parse:\nbrowser, OS, device. Adds server received_at, site + workspace ids, event id,\nvisitor pseudonym, session id, bot flag.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GeoIP (dbip-city-lite.mmdb): country / region / city. User-agent parse:\nbrowser, OS, device. Adds server received_at, site + workspace ids, event id,\nvisitor pseudonym, session id, bot flag.",
