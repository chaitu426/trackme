   "roundness": null,
   "text": "E7. Async publisher + Kafka producer",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "E7. Async publisher + Kafka producer",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 372193,
   "version": 1,
   "versionNonce": 4922263,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "t47",
   "x": 992,
   "y": 1122,
   "width": 588,
   "height": 122.5,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Bounded in-memory queue -> batching flusher -> kafka-go writer, acks=all,\nzstd. Message key = siteId:sessionId (a session stays ordered in one\npartition), headers site_id + type. [KAFKA_SHUFFLE_K] shuffle-shards a site\nacross a subset of partitions.\n[EDGE_WAL_DIR] if Kafka stalls, batches spill to a disk WAL (gzip segments)\nand replay oldest-first on recovery instead of 429/drop. Dedupe claims\nconfirmed asynchronously after the 202.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Bounded in-memory queue -> batching flusher -> kafka-go writer, acks=all,\nzstd. Message key = siteId:sessionId (a session stays ordered in one\npartition), headers site_id + type. [KAFKA_SHUFFLE_K] shuffle-shards a site\nacross a subset of partitions.\n[EDGE_WAL_DIR] if Kafka stalls, batches spill to a disk WAL (gzip segments)\nand replay oldest-first on recovery instead of 429/drop. Dedupe claims\nconfirmed asynchronously after the 202.",
   "lineHeight": 1.25,
   "autoResize": true
  },
