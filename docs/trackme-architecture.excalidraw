   "type": "text",
   "id": "t27",
   "x": 992,
   "y": 329.5,
   "width": 611.5200000000001,
   "height": 87.5,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "SHA-256(public site key) -> in-process cache (TTL, serves stale if Postgres is\nbriefly down) -> Postgres sites.public_key_hash. Loads privacy settings,\nallowed domains, signingRequired, secret, workspace/plan. Redis pub/sub\ninvalidation drops the cache entry when settings or the signing secret change.\nUnknown key -> 401.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SHA-256(public site key) -> in-process cache (TTL, serves stale if Postgres is\nbriefly down) -> Postgres sites.public_key_hash. Loads privacy settings,\nallowed domains, signingRequired, secret, workspace/plan. Redis pub/sub\ninvalidation drops the cache entry when settings or the signing secret change.\nUnknown key -> 401.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "roughness": 0,
