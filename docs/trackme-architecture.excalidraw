   "x": 992,
   "y": 495,
   "width": 580.1600000000001,
   "height": 70,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Origin / domain allow-list (403), DNT + localhost policy, consent header\nX-GI-Consent (403), HMAC X-GI-Signature + X-GI-Timestamp when signing is\nrequired (401; stale timestamp rejected = replay window closed). Client IP\nresolved from trusted proxy headers (clientip).",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Origin / domain allow-list (403), DNT + localhost policy, consent header\nX-GI-Consent (403), HMAC X-GI-Signature + X-GI-Timestamp when signing is\nrequired (401; stale timestamp rejected = replay window closed). Client IP\nresolved from trusted proxy headers (clientip).",
   "lineHeight": 1.25,
   "autoResize": true
  },
