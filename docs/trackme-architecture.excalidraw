   "x": 1692,
   "y": 140,
   "width": 305.76000000000005,
   "height": 157.5,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Topic growth_events (key\nsiteId:sessionId, zstd, acks=all).\nDurable buffer that decouples\ncollection from storage: a ClickHouse\nor worker outage becomes consumer lag,\nnot data loss. Two independent consumer\ngroups read it. Local: docker-compose.\nManaged: Aiven (infra/aiven creates\ntopics).",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Topic growth_events (key\nsiteId:sessionId, zstd, acks=all).\nDurable buffer that decouples\ncollection from storage: a ClickHouse\nor worker outage becomes consumer lag,\nnot data loss. Two independent consumer\ngroups read it. Local: docker-compose.\nManaged: Aiven (infra/aiven creates\ntopics).",
   "lineHeight": 1.25,
   "autoResize": true
  },
