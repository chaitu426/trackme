   "strokeColor": "#555",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Reading order: 1) CDN delivers tracker.js  2) SDK batches events  3) optional proxy signs  4) Go edge validates / limits / enriches  5) Kafka buffers  6) workers insert into ClickHouse + update Redis realtime  7) web app reads ClickHouse / Redis / Postgres  8) scheduler rolls up, meters, prunes, reconciles.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
