   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Edge: IP + site counters, monthly quota counters, dedupe\nclaims, lease state, site-cache invalidation pub/sub.\nWorker: realtime sets + rt:notify pub/sub.\nWeb: sessions, OTP / login challenges, rate limits,\nquery-result cache, SSE hub subscriber.\nScheduler: distributed job locks.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Edge: IP + site counters, monthly quota counters, dedupe\nclaims, lease state, site-cache invalidation pub/sub.\nWorker: realtime sets + rt:notify pub/sub.\nWeb: sessions, OTP / login challenges, rate limits,\nquery-result cache, SSE hub subscriber.\nScheduler: distributed job locks.",
