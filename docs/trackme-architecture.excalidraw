   "id": "t14",
   "x": 532,
   "y": 140,
   "width": 368.48,
   "height": 210,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Build: pnpm --filter tracker build ->\ndist/manifest.json (file, version, SRI hash).\ncopy-tracker-assets.mjs publishes into\napps/web/public/t/:\n  /t/v1/tracker.js alias (Cache-Control 5 min +\n  stale-while-revalidate)\n  /t/<ver>/tracker.<hash>.js (immutable, 1\n  year)\n  /t/manifest.json (version, path, integrity)\nTRACKER_CDN_URL chooses the host, falls back to\nAPP_URL. The tracker-docs site (:3002)\ndocuments the snippet.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Build: pnpm --filter tracker build ->\ndist/manifest.json (file, version, SRI hash).\ncopy-tracker-assets.mjs publishes into\napps/web/public/t/:\n  /t/v1/tracker.js alias (Cache-Control 5 min +\n  stale-while-revalidate)\n  /t/<ver>/tracker.<hash>.js (immutable, 1\n  year)\n  /t/manifest.json (version, path, integrity)\nTRACKER_CDN_URL chooses the host, falls back to\nAPP_URL. The tracker-docs site (:3002)\ndocuments the snippet.",
   "lineHeight": 1.25,
   "autoResize": true
  },
