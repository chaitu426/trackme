   "id": "t23",
   "x": 992,
   "y": 164,
   "width": 611.5200000000001,
   "height": 87.5,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "net/http mux: POST /v1/batch, POST /v1/e, GET /health /ready /metrics.\nlimited(): concurrency cap - over the limit = immediate 503 + jittered\nRetry-After BEFORE the body is read (protects the process). Body capped at 32\nKB, JSON parsed, 1-50 events required else 400. Under pressure responses carry\nX-GI-Backoff so the SDK spaces its next flush.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "net/http mux: POST /v1/batch, POST /v1/e, GET /health /ready /metrics.\nlimited(): concurrency cap - over the limit = immediate 503 + jittered\nRetry-After BEFORE the body is read (protects the process). Body capped at 32\nKB, JSON parsed, 1-50 events required else 400. Under pressure responses carry\nX-GI-Backoff so the SDK spaces its next flush.",
   "lineHeight": 1.25,
   "autoResize": true
  },
