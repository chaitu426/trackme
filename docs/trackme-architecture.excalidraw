   "verticalAlign": "top",
   "containerId": null,
   "originalText": "E4. Per-event validate / normalize",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "roughness": 0,
   "opacity": 100,
