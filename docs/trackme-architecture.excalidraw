   "height": 70,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Messages that fail JSON parse or\ncontract validation are parked here\nwith the reason instead of blocking the\npartition; replay after a fix.",
