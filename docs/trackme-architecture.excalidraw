   "type": "text",
   "id": "t35",
   "x": 992,
   "y": 643,
   "width": 611.5200000000001,
   "height": 70,
   "strokeColor": "#333",
   "backgroundColor": "transparent",
   "strokeStyle": "solid",
   "roundness": null,
   "text": "validate.Event mirrors the shared contract: a bad event is rejected on its own\n(counted as rejected) and never blocks the batch. Normalize fields, clamp\ntimestamps (future or older than 24 h -> server time), drop known\ncrawlers/bots (not billed).",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "validate.Event mirrors the shared contract: a bad event is rejected on its own\n(counted as rejected) and never blocks the batch. Normalize fields, clamp\ntimestamps (future or older than 24 h -> server time), drop known\ncrawlers/bots (not billed).",
   "lineHeight": 1.25,
   "autoResize": true
  },
