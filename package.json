{
  "name": "trackme-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade, privacy-first, multi-tenant B2B SaaS growth intelligence & analytics platform",
  "author": "Growth Intelligence Team",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @trackme/db db:generate",
    "db:migrate": "pnpm --filter @trackme/db db:migrate",
    "security:guard": "node scripts/security-guard.mjs",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:rotate-secrets": "tsx scripts/rotate-secrets.ts",
    "traffic:simulate": "tsx scripts/simulate-traffic.ts",
    "seed:demo": "tsx scripts/seed-demo-site.ts",
    "seed:identified": "tsx scripts/seed-identified-users.ts",
    "geoip:download": "bash scripts/download-geoip.sh",
    "build:app": "turbo run build --filter=@trackme/web --filter=@trackme/tracker-docs --filter=@trackme/ingestion-go --filter=@trackme/event-worker --filter=@trackme/scheduled-worker --filter=@trackme/ask-worker --env-mode=loose",
    "start:web": "pnpm --filter @trackme/web start",
    "start:docs": "pnpm --filter @trackme/tracker-docs start",
    "start:edge": "pnpm --filter @trackme/ingestion-go start",
    "start:worker": "pnpm --filter @trackme/event-worker start",
    "start:scheduler": "pnpm --filter @trackme/scheduled-worker start",
    "start:ask": "pnpm --filter @trackme/ask-worker start",
    "start:all": "turbo run start --filter=@trackme/web --filter=@trackme/tracker-docs --filter=@trackme/ingestion-go --filter=@trackme/event-worker --filter=@trackme/scheduled-worker --filter=@trackme/ask-worker --env-mode=loose --ui=stream",
    "dev:ingest": "pnpm --filter @trackme/ingestion-go dev",
    "dev:ingest-proxy": "cd services/ingest-proxy && go run .",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "seed:suite": "pnpm --filter @trackme/scheduled-worker exec tsx seed-suite-demo.mts"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "uuid": "^11.1.1",
      "shell-quote": "^1.11.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
